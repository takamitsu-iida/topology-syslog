{
  "network-model": {
    "physical-layer": {
      "device": [
        {
          "device-id": "Core-Router1",
          "device-name": "Core Router 1",
          "device-type": "router",
          "role": "core",
          "loopback": "10.0.0.1/32",
          "interface": [
            {
              "interface-id": "GigabitEthernet0/0",
              "description": "To Dist-Switch1",
              "ip-address": "10.1.0.1/30"
            },
            {
              "interface-id": "GigabitEthernet0/1",
              "description": "To Branch-Router2",
              "ip-address": "10.1.1.1/30"
            }
          ]
        },
        {
          "device-id": "Dist-Switch1",
          "device-name": "Distribution Switch 1",
          "device-type": "switch",
          "role": "distribution",
          "loopback": "10.0.0.2/32",
          "interface": [
            {
              "interface-id": "GigabitEthernet0/0",
              "description": "Uplink to Core-Router1",
              "ip-address": "10.1.0.2/30"
            },
            {
              "interface-id": "GigabitEthernet0/1",
              "description": "To Access-SW1",
              "ip-address": "10.1.2.1/30"
            }
          ]
        },
        {
          "device-id": "Access-SW1",
          "device-name": "Access Switch 1",
          "device-type": "switch",
          "role": "access",
          "interface": [
            {
              "interface-id": "GigabitEthernet0/0",
              "description": "Uplink to Dist-Switch1",
              "ip-address": "10.1.2.2/30"
            }
          ]
        },
        {
          "device-id": "Branch-Router2",
          "device-name": "Branch Router 2",
          "device-type": "router",
          "role": "border",
          "loopback": "10.0.0.4/32",
          "interface": [
            {
              "interface-id": "GigabitEthernet0/0",
              "description": "WAN uplink"
            },
            {
              "interface-id": "GigabitEthernet0/1",
              "description": "To Branch-Access-SW1",
              "ip-address": "10.1.3.1/30"
            }
          ]
        },
        {
          "device-id": "Branch-Access-SW1",
          "device-name": "Branch Access Switch 1",
          "device-type": "switch",
          "role": "access",
          "interface": [
            {
              "interface-id": "GigabitEthernet0/0",
              "description": "Uplink to Branch-Router2",
              "ip-address": "10.1.3.2/30"
            }
          ]
        }
      ],
      "physical-connection": [
        {
          "connection-id": "Core-Router1__Dist-Switch1",
          "endpoint": [
            {"device-id": "Core-Router1",  "interface-id": "GigabitEthernet0/0"},
            {"device-id": "Dist-Switch1",  "interface-id": "GigabitEthernet0/0"}
          ]
        },
        {
          "connection-id": "Dist-Switch1__Access-SW1",
          "endpoint": [
            {"device-id": "Dist-Switch1", "interface-id": "GigabitEthernet0/1"},
            {"device-id": "Access-SW1",   "interface-id": "GigabitEthernet0/0"}
          ]
        },
        {
          "connection-id": "Branch-Router2__Branch-Access-SW1",
          "endpoint": [
            {"device-id": "Branch-Router2",     "interface-id": "GigabitEthernet0/1"},
            {"device-id": "Branch-Access-SW1",  "interface-id": "GigabitEthernet0/0"}
          ]
        }
      ]
    }
  }
}
