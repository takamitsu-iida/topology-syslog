# --- LLMプロバイダー選択 ---

# AIによるレポート生成を有効化する場合は true に設定
AI_ENABLED=true

# "openai" / "anthropic" / "ollama" のいずれかを指定
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama（ローカルLLM）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# ── Cisco CML ────────────────────────
CML_URL=https://your-cml-server
CML_USERNAME=admin
CML_PASSWORD=your_password
CML_VERIFY_SSL=false

# ── バックエンドサーバー (python -m topology_syslog) ────────────────────────

# トポロジーファイル (iida-network-model YAML 形式)
TOPOLOGY_PATH=configs/clos/yang_topology.yaml
TOPOLOGY_SOURCE=iida-yaml
# TOPOLOGY_SOURCE=ietf-json

# SYSLOG Knowledge Base: 分類、Severity ポリシー、runbook を読み込む
SKB_PATH=configs/syslog_knowledge

# 旧無視パターンファイル（互換用途）。新規の抑制ルールは SKB の retain_only を使用する。
# SYSLOG_IGNORE_FILE=configs/syslog_ignore.txt

# データベース (SQLite → PostgreSQL に移行する場合は変更)
DATABASE_URL=sqlite:///./incidents.db

# API サーバー
API_HOST=0.0.0.0
API_PORT=8080
SYSLOG_HOST=0.0.0.0
SYSLOG_PORT=1514
LOG_LEVEL=info

# CORS 許可オリジン (カンマ区切り。* で全許可)
CORS_ORIGINS=*

# API 認証。Docker Compose では AUTH_ENABLED=true が固定されるため、
# 少なくとも AUTH_ADMIN_TOKEN を長いランダム値に変更して設定する。
# AUTH_ENABLED=false
# AUTH_READER_TOKEN=replace-with-reader-secret
# AUTH_OPERATOR_TOKEN=replace-with-operator-secret
# AUTH_ADMIN_TOKEN=replace-with-a-long-random-secret

# 相関モード: immediate が標準動作。time_window は旧互換のためのみ受け付ける。
CORRELATION_MODE=immediate

# Severity がこの値以下の SYSLOG を既存の根本原因推論対象にする（0=EMERGENCY, 7=DEBUG）
INFERENCE_SEVERITY_THRESHOLD=5

# 同一ノード・同一イベントの繰り返しをフラッピングとして扱う件数
FLAPPING_THRESHOLD=3

# 旧式タイムウィンド設定は非推奨。immediate モードでは無視される。
# WINDOW_SEC=30
# BURST_WINDOW_SEC=5
# BURST_THRESHOLD=3
# WINDOW_EXTEND_FACTOR=2.0
# WINDOW_SEC_MAX=120

# メンテナンス計画 YAML のディレクトリ（未設定で無効）
# MAINTENANCE_DIR=configs/maintenance

# ── vigil 連携 ────────────────────────────────────────────────────────────

# vigil サーバーの URL（設定するとインシデントを自動転送。未設定で無効）
# VIGIL_URL=http://vigil:8000

# vigil の通知先チーム名（vigil のオンコールスケジュールと対応させる）
# VIGIL_TEAM=network

# ── 装置調査エージェント (pyATS) ──────────────────────────────────────────

# 装置調査エージェントを有効化する場合は true に設定
# INVESTIGATION_ENABLED=true

# pyATS testbed YAML ファイルのパス（INVESTIGATION_ENABLED=true の場合は必須）
# PYATS_TESTBED_FILE=configs/clos/testbed.yaml

# LLM エージェントの最大ターン数（デフォルト 8）
# INVESTIGATION_MAX_TURNS=8

# SSH コマンドタイムアウト（秒、デフォルト 30）
# INVESTIGATION_COMMAND_TIMEOUT=30

# ──────────────────────────────────────────────────────────────────────────
