# --- LLMプロバイダー選択 ---
# "openai" / "anthropic" / "ollama" のいずれかを指定
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama（ローカルLLM）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# Cisco CML
CML_URL=https://your-cml-server
CML_USERNAME=admin
CML_PASSWORD=your_password
CML_VERIFY_SSL=false

# ── バックエンドサーバー (python -m topology_syslog) ────────────────────────
# topology-syslog バックエンドの起動設定

# トポロジーファイル (iida-network-model YAML 形式)
TOPOLOGY_PATH=configs/clos/yang_topology.yaml
TOPOLOGY_SOURCE=iida-yaml
# TOPOLOGY_SOURCE=ietf-json

# Syslog 無視パターンファイル
SYSLOG_IGNORE_FILE=configs/clos/syslog_ignore.txt

# データベース (SQLite → PostgreSQL に移行する場合は変更)
DATABASE_URL=sqlite:///./incidents.db

# API サーバー
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info

# CORS 許可オリジン (カンマ区切り。* で全許可)
CORS_ORIGINS=*
# ──────────────────────────────────────────────────────────────────────────

# エージェント設定
MAX_RETRIES=5

# Phase I: 実機適用モード（--apply-to-live）
# 実機への SSH ログイン情報
LIVE_USERNAME=your_device_username
LIVE_PASSWORD=your_device_password
# トラブルシューティング最大リトライ回数
TROUBLESHOOT_MAX_RETRIES=3
