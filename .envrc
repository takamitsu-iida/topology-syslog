source .venv/bin/activate
unset PS1

# PYTHONPATH
# export PYTHONPATH=$PWD/genieparser:$PWD/genielibs:$PYTHONPATH

# pyATS external genie parser
# export PYATS_LIBS_EXTERNAL_PARSER=external_parser

# The inherited Menlo proxy presents a certificate chain unavailable here.
unset HTTP_PROXY HTTPS_PROXY ALL_PROXY
unset http_proxy https_proxy all_proxy

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ca_bundle="$project_root/certs/local-ca-bundle.pem"

if [[ -f "$ca_bundle" ]]; then
        export REQUESTS_CA_BUNDLE="$ca_bundle"
        export SSL_CERT_FILE="$ca_bundle"
else
        echo "Warning: local CA bundle not found: $ca_bundle" >&2
fi

unset project_root ca_bundle